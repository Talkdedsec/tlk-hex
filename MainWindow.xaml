<Window x:Class="tlk_hex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:tlk_hex.UI"
        Title="tlk-hex" Height="860" Width="1380"
        MinHeight="560" MinWidth="900"
        Icon="resources/app.ico"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12.5"
        Drop="Window_Drop" DragEnter="Window_DragEnter">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="2,1"/>

        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="3,2">
            <WrapPanel x:Name="ToolBarPanel" Orientation="Horizontal"/>
        </Border>

        <Border DockPanel.Dock="Top" Padding="3,2,3,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ui:NavBand x:Name="Nav"/>
        </Border>

        <Border x:Name="StatusBorder" DockPanel.Dock="Bottom" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Ellipse x:Name="AuDot" Width="9" Height="9" Fill="#3CB043" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AuText" Text="AU:  idle" FontFamily="Consolas" VerticalAlignment="Center" MinWidth="120"/>
                </StackPanel>
                <TextBlock x:Name="DirText" Grid.Column="1" Text="Down" FontFamily="Consolas" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="DiskText" Grid.Column="2" Text="Disk: -" FontFamily="Consolas" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusMsg" Grid.Column="3" Margin="18,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusRight" Grid.Column="4" FontFamily="Consolas" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDimBrush}"/>
            </Grid>
        </Border>

        <ContentControl x:Name="DockHost"/>
    </DockPanel>
</Window>
